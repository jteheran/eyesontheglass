---
import type { CollectionEntry } from "astro:content";
import { getCollection } from "astro:content";
import { slugifyStr } from "@/utils/slugify";
import { getPath } from "@/utils/getPath";
import Datetime from "./Datetime.astro";

type Props = {
  variant?: "h2" | "h3";
} & CollectionEntry<"blog">;

const { variant: Heading = "h2", id, data, filePath } = Astro.props;

const { title, description, author, ...props } = data;

const authors = await getCollection("authors");
const authorData = authors.find(
  a => a.data.name.toUpperCase() === (author ?? "").toUpperCase()
);
const avatar = authorData?.data.avatar;
const color = authorData?.data.color ?? "var(--color-accent)";
---

<li class="my-6">
  <a
    href={getPath(id, filePath)}
    class:list={[
      "inline-block text-lg font-medium text-accent",
      "decoration-dashed underline-offset-4 hover:underline",
      "focus-visible:no-underline focus-visible:underline-offset-0",
    ]}
  >
    <Heading
      style={{ viewTransitionName: slugifyStr(title.replaceAll(".", "-")) }}
    >
      {title}
    </Heading>
  </a>
  <div class="flex items-center gap-2 mt-1">
    {avatar ? (
      <img
        src={avatar}
        alt={author ?? ""}
        width="18"
        height="18"
        class="rounded-full object-cover flex-shrink-0"
        style={`border: 1px solid ${color};`}
      />
    ) : (
      <div
        class="flex-shrink-0 rounded-full flex items-center justify-center"
        style={`width: 18px; height: 18px; border: 1px solid ${color}; background: ${color}18;`}
      >
        <span style={`font-size: 9px; font-weight: 800; color: ${color};`}>
          {(author ?? "?").charAt(0)}
        </span>
      </div>
    )}
    <Datetime {...props} />
  </div>
  <p>{description}</p>
</li>
