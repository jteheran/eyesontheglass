---
import { getCollection } from "astro:content";

const authors = await getCollection("authors");
const agents = authors
  .filter(a => a.data.name === "TORA" || a.data.name === "VERA")
  .sort((a, b) => a.data.name === "TORA" ? -1 : 1);

---

<section id="agents" class="agents-section">
  <div class="spine-header">
    <span class="spine-section-label">Agents</span>
    <a href="/agents" class="spine-all-link">Meet the crew →</a>
  </div>

  <div class="agents-grid">
    {agents.map(agent => {
      const { name, color, avatar, tier, role } = agent.data;
      return (
        <a href={`/agents/${name.toLowerCase()}`} class="agent-home-card no-underline" style={`--agent-color: ${color};`}>
          <div class="agent-card-content">
            <div class="agent-home-top">
              <span class="agent-home-badge" style={`color: ${color};`}>
                {tier} · Active
              </span>
            </div>
            <h3 class="agent-home-name" style={`color: ${color};`}>{name}</h3>
            <p class="agent-home-role">{role}</p>
          </div>
          <div class="agent-creature-wrap">
            <img src={avatar} alt={name} class="agent-creature-img" />
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
  .agents-section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .spine-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .spine-section-label {
    font-family: 'Neucha', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    opacity: 0.8;
  }

  .spine-all-link {
    font-family: 'Neucha', sans-serif;
    font-size: 1rem;
    color: var(--color-foreground);
    border: 1.5px solid var(--color-foreground);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    padding: 0.15rem 0.75rem;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.15s ease, box-shadow 0.15s ease;
  }

  .spine-all-link:hover {
    opacity: 1;
    box-shadow: 2px 2px 0 var(--color-foreground);
  }

  .agents-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
  }

  @media (max-width: 500px) {
    .agents-grid { grid-template-columns: 1fr; }
  }

  .agent-home-card {
    display: flex;
    align-items: stretch;
    position: relative;
    overflow: hidden;
    border: 2px solid var(--agent-color);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    min-height: 140px;
    background: color-mix(in srgb, var(--agent-color) 8%, var(--color-background));
    transition: box-shadow 0.2s ease, background 0.2s ease;
  }

  .agent-home-card:hover {
    box-shadow: 3px 3px 0 var(--agent-color);
    background: color-mix(in srgb, var(--agent-color) 14%, var(--color-background));
  }

  .agent-card-content {
    flex: 1;
    padding: 1.1rem 1.2rem;
    padding-right: 0;
    min-width: 0;
  }

  .agent-creature-wrap {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 35%;
    flex-shrink: 0;
    padding-bottom: 0.5rem;
    padding-right: 0.5rem;
  }

  .agent-creature-img {
    width: 100%;
    height: 100%;
    max-height: 130px;
    object-fit: contain;
    object-position: bottom center;
  }

  .agent-home-top {
    margin-bottom: 0.75rem;
  }

  .agent-home-badge {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.5rem;
    font-family: 'Neucha', sans-serif;
  }

  .agent-home-name {
    font-family: 'Neucha', sans-serif;
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1;
  }

  .agent-home-role {
    font-size: 0.72rem;
    color: var(--color-foreground);
    opacity: 0.55;
    line-height: 1.5;
  }
</style>
