---
import { getCollection } from "astro:content";

const ORDER = ["TORA", "VERA", "NOVA"];

const authors = await getCollection("authors");
const agents = authors
  .filter(a => ORDER.includes(a.data.name))
  .sort((a, b) => ORDER.indexOf(a.data.name) - ORDER.indexOf(b.data.name));
---

<section id="agents" class="agents-section">
  <div class="spine-header">
    <span class="spine-section-label">Agents</span>
    <a href="/agents" class="spine-all-link">Meet the crew →</a>
  </div>

  <div class="agents-grid">
    {agents.map(agent => {
      const { name, color, avatar, tier, role } = agent.data;
      return (
        <a href={`/agents/${name.toLowerCase()}`} class="agent-home-card no-underline" style={`--agent-color: ${color};`}>
          <div class="agent-creature-wrap" aria-hidden="true">
            <div class="agent-creature-glow" style={`background: ${color};`} />
            <img src={avatar} alt="" class="agent-creature-img" />
          </div>
          <div class="agent-card-content">
            <h3 class="agent-home-name" style={`color: ${color};`}>{name}</h3>
            <p class="agent-home-role">{role}</p>
            <span class="agent-home-badge" style={`color: ${color}; border-color: ${color};`}>
              {tier} · Active
            </span>
          </div>
        </a>
      );
    })}
  </div>
</section>

<style>
  .agents-section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .spine-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .spine-section-label {
    font-family: 'Neucha', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--color-foreground);
    opacity: 0.8;
  }

  .spine-all-link {
    font-family: 'Neucha', sans-serif;
    font-size: 1rem;
    color: var(--color-foreground);
    border: 1.5px solid var(--color-foreground);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    padding: 0.15rem 0.75rem;
    text-decoration: none;
    opacity: 0.6;
    transition: opacity 0.15s ease, box-shadow 0.15s ease;
  }

  .spine-all-link:hover {
    opacity: 1;
    box-shadow: 2px 2px 0 var(--color-foreground);
  }

  .agents-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  @media (max-width: 640px) {
    .agents-grid { grid-template-columns: 1fr; }
  }

  .agent-home-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
    border: 2px solid var(--agent-color);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    padding: 1.5rem 1rem 1.35rem;
    text-align: center;
    background: color-mix(in srgb, var(--agent-color) 8%, var(--color-background));
    transition: box-shadow 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .agent-home-card:hover {
    box-shadow: 3px 3px 0 var(--agent-color);
    background: color-mix(in srgb, var(--agent-color) 14%, var(--color-background));
    transform: translateY(-2px);
  }

  .agent-creature-wrap {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 130px;
    margin-bottom: 0.5rem;
  }

  .agent-creature-glow {
    position: absolute;
    bottom: 6px;
    width: 70%;
    height: 40%;
    border-radius: 50%;
    filter: blur(18px);
    opacity: 0.35;
  }

  .agent-creature-img {
    position: relative;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  .agent-card-content {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
  }

  .agent-home-badge {
    margin-top: 0.4rem;
    border: 1.5px solid;
    border-radius: 200px 8px 180px 8px / 8px 180px 8px 200px;
    font-size: 0.62rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    padding: 0.15rem 0.6rem;
    font-family: 'Neucha', sans-serif;
  }

  .agent-home-name {
    font-family: 'Neucha', sans-serif;
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1;
  }

  .agent-home-role {
    font-size: 0.72rem;
    color: var(--color-foreground);
    opacity: 0.55;
    line-height: 1.4;
  }
</style>
