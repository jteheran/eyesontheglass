---
import IconX from "@/assets/icons/IconX.svg";
import IconMoon from "@/assets/icons/IconMoon.svg";
import IconSearch from "@/assets/icons/IconSearch.svg";
import IconSunHigh from "@/assets/icons/IconSunHigh.svg";
import IconMenuDeep from "@/assets/icons/IconMenuDeep.svg";
import LinkButton from "./LinkButton.astro";
import { SITE } from "@/config";

const { pathname } = Astro.url;

// Remove trailing slash from current pathname if exists
const currentPath =
  pathname.endsWith("/") && pathname !== "/" ? pathname.slice(0, -1) : pathname;

const isActive = (path: string) => {
  const currentPathArray = currentPath.split("/").filter(p => p.trim());
  const pathArray = path.split("/").filter(p => p.trim());

  return currentPath === path || currentPathArray[0] === pathArray[0];
};
---

<a
  id="skip-to-content"
  href="#main-content"
  class="absolute start-16 -top-full z-50 bg-background px-3 py-2 text-accent backdrop-blur-lg transition-all focus:top-4"
>
  Skip to content
</a>

<header
  class="app-layout flex flex-col items-center justify-between sm:flex-row"
>
  <div
    id="top-nav-wrap"
    class:list={[
      "py-4 sm:py-6",
      "border-b border-border",
      "relative w-full bg-background",
      "flex items-center justify-between",
    ]}
  >
    <a
      href="/"
      class="site-logo py-1 text-2xl sm:text-4xl leading-8 font-semibold whitespace-nowrap flex-shrink-0"
    >
      {SITE.title}
    </a>
    <nav
      id="nav-menu"
      class="flex items-center justify-end sm:ms-2 sm:flex-row sm:space-x-4 sm:py-0"
    >
      <button
        id="menu-btn"
        class="focus-outline self-end p-2 sm:hidden"
        aria-label="Open Menu"
        aria-expanded="false"
        aria-controls="menu-items"
      >
        <IconX id="close-icon" class="hidden" />
        <IconMenuDeep id="menu-icon" />
      </button>
      <ul
        id="menu-items"
        class:list={[
          "mt-4 grid w-44 grid-cols-2 place-content-center gap-2",
          "hidden",
          "sm:mt-0 sm:flex sm:w-auto sm:items-center sm:gap-2",
        ]}
      >
        <li class="col-span-2 sm:col-span-1">
          <a href="/the-soc" class:list={["paper-nav-btn", { "paper-nav-active": isActive("/the-soc") }]}>
            The SOC
          </a>
        </li>
        <li class="col-span-2 sm:col-span-1">
          <a href="/shifts" class:list={["paper-nav-btn", { "paper-nav-active": isActive("/shifts") }]}>
            Shifts
          </a>
        </li>
        <li class="col-span-2 sm:col-span-1">
          <a href="/agents" class:list={["paper-nav-btn", { "paper-nav-active": isActive("/agents") }]}>
            Agents
          </a>
        </li>
        <li class="col-span-1 flex items-center justify-center sm:ml-2">
          <LinkButton
            href="/search"
            class:list={[
              "focus-outline flex p-3 sm:p-1",
              { "[&>svg]:stroke-accent": isActive("/search") },
            ]}
            title="Search"
            aria-label="search"
          >
            <IconSearch />
            <span class="sr-only">Search</span>
          </LinkButton>
        </li>
        {
          SITE.lightAndDarkMode && (
            <li class="col-span-1 flex items-center justify-center">
              <button
                id="theme-btn"
                class="focus-outline relative size-12 p-4 sm:size-8 hover:[&>svg]:stroke-accent"
                title="Toggles light & dark"
                aria-label="auto"
                aria-live="polite"
              >
                <IconMoon class="absolute top-[50%] left-[50%] -translate-[50%] scale-100 rotate-0 transition-all dark:scale-0 dark:-rotate-90" />
                <IconSunHigh class="absolute top-[50%] left-[50%] -translate-[50%] scale-0 rotate-90 transition-all dark:scale-100 dark:rotate-0" />
              </button>
            </li>
          )
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-logo {
    font-family: 'Neucha', sans-serif;
    background: linear-gradient(135deg, #3f6291 0%, #4a1a6b 25%, #8b2a6b 50%, #d4a5c9 75%, #f5c6a5 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  :global([data-theme="dark"]) .site-logo {
    font-family: 'Neucha', sans-serif;
    background: linear-gradient(135deg, #7eb3e8 0%, #b07fd4 30%, #d4689e 55%, #e8a8d0 78%, #f5c6a5 100%);
    background-clip: text;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .paper-nav-btn {
    font-family: 'Neucha', sans-serif;
    font-size: 24px;
    color: var(--color-foreground);
    text-decoration: none;
    display: inline-flex;
    align-items: center;
    padding: 5px 16px;
    background: var(--color-background);
    transition: box-shadow 0.1s, transform 0.1s;
    white-space: nowrap;
    border: 1.5px solid var(--color-foreground);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.15);
    padding-bottom: 0.1rem;
  }

  .paper-nav-btn:hover {
    box-shadow: 1px 1.5px 0 rgba(0, 0, 0, 0.2);
    transform: translate(1px, 1.5px);
    text-decoration: none;
    color: var(--color-foreground);
  }

  .paper-nav-btn:active {
    box-shadow: none;
    transform: translate(2px, 3px);
  }

  .paper-nav-active {
    background: var(--color-foreground);
    color: var(--color-background);
    box-shadow: 2px 3px 0 rgba(0, 0, 0, 0.15);
  }

  .paper-nav-active:hover {
    color: var(--color-background);
  }

  :global([data-theme="dark"]) .paper-nav-btn {
    box-shadow: 2px 3px 0 rgba(255, 255, 255, 0.08);
  }
</style>

