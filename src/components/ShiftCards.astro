---
import { getCollection } from "astro:content";
import { SHIFTS } from "@/data/shifts";

const allPosts = await getCollection("blog");
const allAuthors = await getCollection("authors");
const colorByName: Record<string, string> = Object.fromEntries(
  allAuthors.map(a => [a.data.name, a.data.color])
);

const recentShifts = [...SHIFTS].reverse().slice(0, 3);

const shiftData = recentShifts.map(shift => {
  const posts = allPosts.filter(p => p.data.shift === shift.id && !p.data.draft);
  const toraPost = posts.find(p => p.data.author === "TORA");
  const veraPost = posts.find(p => p.data.author === "VERA");
  const jenyPost = posts.find(p => p.data.author === "JENY");

  // The shift number is colored by whichever agents actually ran the shift —
  // two-tone through Shift 12, three-tone from Shift 13 on once NOVA joins.
  const agentColors = shift.agents.map(name => colorByName[name]).filter(Boolean);
  const agentGradient = agentColors.length > 1
    ? agentColors.join(", ")
    : `${agentColors[0]}, ${agentColors[0]}`;

  return { ...shift, posts, toraPost, veraPost, jenyPost, agentGradient };
});

function formatDateRange(startDate: string, endDate: string): string {
  const [sy, sm, sd] = startDate.slice(0, 10).split("-").map(Number);
  const [ey, em, ed] = endDate.slice(0, 10).split("-").map(Number);
  const months = ["Jan","Feb","Mar","Apr","May","Jun","Jul","Aug","Sep","Oct","Nov","Dec"];
  const startMonth = months[sm - 1];
  const endMonth = months[em - 1];
  if (sm === em) return `${startMonth} ${sd}–${ed}, ${ey}`;
  return `${startMonth} ${sd} – ${endMonth} ${ed}, ${ey}`;
}
---

<section id="shifts" class="shifts-section">
  <div class="section-header">
    <a href="/shifts" class="section-label">Shifts — Weekly SOC Operations Log</a>
    <a href="/shifts" class="section-more">View all →</a>
  </div>

  <div class="shifts-grid">
    {shiftData.map((shift, i) => (
      <a href={`/shifts/${shift.id}`} class={`shift-home-card no-underline${i === 0 ? " shift-home-card--latest" : ""}`} style={`--shift-gradient: linear-gradient(135deg, ${shift.agentGradient});`}>
        <div class="shift-card-top">
          <span class="shift-sprint-badge" style={i === 0 ? "border-color: #F97316; color: #F97316; opacity: 1;" : ""}>
            {shift.sprintLabel}
          </span>
          <span class="shift-num-small">#{shift.id.replace("shift-", "")}</span>
        </div>

        <h3 class="shift-home-title">{shift.title}</h3>
        <p class="shift-home-date">{formatDateRange(shift.startDate, shift.endDate)}</p>

        {shift.stats && (
          <p class="shift-home-meta">
            <span style="color: #F97316;">{shift.stats.alertsTotal} alerts</span>
            {" · "}
            <span style="color: #0D9488;">{shift.stats.casesTotal} cases</span>
          </p>
        )}

        {(shift.toraPost || shift.veraPost || shift.jenyPost) && (
          <div class="shift-home-posts">
            {[
              { post: shift.toraPost, label: "TORA", color: "#F97316" },
              { post: shift.veraPost, label: "VERA", color: "#0D9488" },
              { post: shift.jenyPost, label: "JENY", color: "#EAB308" },
            ].filter(x => x.post).map(({ post, label, color }) => (
              <div class="shift-home-post-row">
                <span class="shift-post-dot" style={`background: ${color};`} />
                <span class="shift-post-label">{label}: {post!.data.title}</span>
              </div>
            ))}
          </div>
        )}

        {shift.posts.length === 0 && (
          <p class="shift-home-empty">Posts publishing Friday</p>
        )}
      </a>
    ))}
  </div>
</section>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Neucha&display=swap');

  .shifts-section {
    padding: 2.5rem 0;
    border-top: 1px solid var(--color-border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.25rem;
  }

  .section-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--color-foreground);
    opacity: 0.4;
    text-decoration: none;
  }

  .section-more {
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--color-accent);
    text-decoration: none;
    opacity: 0.8;
    transition: opacity 0.15s;
  }

  .section-more:hover { opacity: 1; }

  .shifts-grid {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    padding-bottom: 0.5rem;
    scrollbar-width: none;
  }

  .shifts-grid::-webkit-scrollbar { display: none; }

  .shift-home-card {
    flex: 0 0 280px;
  }

  .shift-home-card {
    display: block;
    border: 1.5px solid var(--color-foreground);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    padding: 1.1rem 1.2rem;
    opacity: 0.7;
    transition: box-shadow 0.2s ease, opacity 0.2s ease;
    min-width: 0;
  }

  .shift-home-card:hover {
    opacity: 1;
    box-shadow: 3px 3px 0 var(--color-foreground);
  }

  .shift-home-card--latest {
    border-color: #F97316;
    opacity: 1;
  }

  .shift-home-card--latest:hover {
    box-shadow: 3px 3px 0 #F97316;
  }

  .shift-card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.6rem;
  }

  .shift-sprint-badge {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    border: 1.5px solid var(--color-foreground);
    color: var(--color-foreground);
    opacity: 0.4;
    padding: 0.15rem 0.5rem;
    border-radius: 100px 4px 90px 4px / 4px 90px 4px 100px;
  }

  .shift-num-small {
    font-family: 'Neucha', sans-serif;
    font-size: 1.1rem;
    font-weight: 700;
    background: var(--shift-gradient);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    opacity: 0.85;
  }

  .shift-home-title {
    font-family: 'Neucha', sans-serif;
    font-size: 1rem;
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.3;
    margin-bottom: 0.25rem;
  }

  .shift-home-date {
    font-size: 0.7rem;
    color: var(--color-foreground);
    opacity: 0.4;
    margin-bottom: 0.4rem;
  }

  .shift-home-meta {
    font-size: 0.7rem;
    margin-bottom: 0.75rem;
  }

  .shift-home-posts {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding-top: 0.6rem;
    border-top: 1px dashed color-mix(in srgb, currentColor 20%, transparent);
  }

  .shift-home-post-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .shift-post-dot {
    width: 6px;
    height: 6px;
    border-radius: 1px;
    flex-shrink: 0;
  }

  .shift-post-label {
    font-size: 0.65rem;
    color: var(--color-foreground);
    opacity: 0.6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .shift-home-empty {
    font-size: 0.7rem;
    color: var(--color-foreground);
    opacity: 0.3;
    font-style: italic;
    margin-top: 0.5rem;
  }
</style>
