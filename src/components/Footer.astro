---
import type { HTMLAttributes } from "astro/types";
import Socials from "./Socials.astro";

const currentYear = new Date().getFullYear();

type Props = {
  noMarginTop?: boolean;
} & HTMLAttributes<"footer">;

const { noMarginTop = false, class: className, ...attrs } = Astro.props;

---

<footer
  class:list={["app-layout", { "mt-auto": !noMarginTop }, className]}
  {...attrs}
>
  <div class:list={["py-8 sm:py-10", "border-t border-border"]}>

    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between mb-8">

      <div>
        <p class="footer-col-header" style="color: #F97316;">Explore</p>
        <ul class="space-y-3">
          <li><a href="/the-soc" class="footer-link">Building the SOC</a></li>
          <li><a href="/shifts" class="footer-link">Shifts</a></li>
          <li><a href="/agents" class="footer-link">Agents</a></li>
          <li><a href="/posts" class="footer-link">All posts</a></li>
        </ul>
      </div>

      <div>
        <p class="footer-col-header" style="color: #0D9488;">Site</p>
        <ul class="space-y-3">
          <li><a href="/about" class="footer-link">About</a></li>
          <li><a href="/talks" class="footer-link">Talks</a></li>
          <li><a href="/gallery" class="footer-link">Gallery</a></li>
          <li><a href="/archives" class="footer-link">Archive</a></li>
          <li><span class="footer-link" style="opacity:.35;cursor:default;">Knowledge Base <span class="text-[9px] font-bold uppercase tracking-wider">soon</span></span></li>
        </ul>
      </div>

      <div>
        <p class="footer-col-header" style="color: #7C3AED;">Contact</p>
        <ul class="space-y-3">
          <li><a href="mailto:info@eyesontheglass.ai" class="footer-link">info@eyesontheglass.ai</a></li>
        </ul>
        <div class="mt-4">
          <Socials />
        </div>
      </div>

    </div>

    <!-- Bottom bar -->
    <div class="border-t border-border pt-4 flex flex-col gap-1 sm:flex-row sm:justify-between sm:items-center">
      <span class="footer-fine">© {currentYear} Eyes on the Glass. All rights reserved.</span>
      <span class="footer-fine" style="opacity:.5;">Built with Astro · Hosted on Cloudflare Pages</span>
    </div>

  </div>
</footer>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Neucha&display=swap');

  .footer-col-header {
    font-family: 'Neucha', sans-serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: 0.04em;
    margin-bottom: 1rem;
    display: block;
  }

  .footer-link {
    font-family: 'Neucha', sans-serif;
    font-size: 20px;
    color: var(--color-foreground);
    opacity: 0.7;
    text-decoration: none;
    transition: opacity 0.15s;
    display: inline-block;
  }

  .footer-link:hover {
    opacity: 1;
    color: var(--color-accent);
  }

  .footer-fine {
    font-family: 'Neucha', sans-serif;
    font-size: 13px;
    color: var(--color-foreground);
    opacity: 0.5;
  }
</style>
