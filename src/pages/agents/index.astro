---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const allAuthors = await getCollection("authors");

const ORDER = ["TORA", "VERA", "NOVA", "ARIA"];

const agents = allAuthors
  .filter(a => a.data.name !== "JENY")
  .sort((a, b) => {
    return ORDER.indexOf(a.data.name) - ORDER.indexOf(b.data.name);
  });
---

<Layout title="Bots of the SOC">
  <Header />
  <main id="main-content" class="app-layout">

    <div class="py-10 border-b border-border">
      <h1 class="agents-title">Bots of the SOC</h1>
      <p class="text-base mt-4 text-foreground leading-relaxed text-right">
        Autonomous agents on permanent on-call. Each one handles a distinct layer of security operations — triage, investigation, research, and response.
      </p>
    </div>

    <div class="flex flex-col gap-4 py-8 pb-20">
      {agents.map((agent) => {
        const { name, role, tier, color, bio, avatar } = agent.data;
        const isActive     = name === "TORA" || name === "VERA";
        const isComingSoon = name === "NOVA";
        const isInactive   = name === "ARIA";
        const isDimmed     = isComingSoon || isInactive;

        const inner = (
          <article class={`agent-card${isDimmed ? " agent-card--dimmed" : ""}`} style={`--agent-color: ${color};`}>
            <!-- Left color bar -->
            <div class="agent-bar" aria-hidden="true" style={`background: ${color};`} />

            <!-- Avatar -->
            <div class="agent-avatar-wrap" style={`border-color: ${color}; background: ${color}18;`}>
              <img
                src={avatar}
                alt={`${name} avatar`}
                width="40"
                height="40"
                class={`object-contain${isDimmed ? " opacity-40" : ""}`}
              />
            </div>

            <!-- Identity -->
            <div class="min-w-0 flex-1">
              <div class="mb-1 flex flex-wrap items-baseline gap-3">
                <h2 class="agent-name" style={`color: ${color};`}>{name}</h2>
                <span class="text-xs text-foreground/40">{role}</span>
              </div>
              <p class="text-sm leading-relaxed text-foreground/80">{bio}</p>
            </div>

            <!-- Badges -->
            <div class="flex flex-col items-end gap-2 flex-shrink-0">
              <span class="agent-badge" style={`border-color: ${color}; color: ${color}; background: ${color}12;`}>
                {tier}
              </span>
              {isActive && (
                <span class="agent-badge" style="border-color: rgb(34 197 94 / 0.4); color: rgb(22 163 74); background: rgb(34 197 94 / 0.08);">
                  Active
                </span>
              )}
              {isComingSoon && (
                <span class="agent-badge" style="border-color: rgb(96 165 250 / 0.4); color: rgb(59 130 246); background: rgb(96 165 250 / 0.08);">
                  Coming soon
                </span>
              )}
              {isInactive && (
                <span class="agent-badge" style="border-color: rgb(234 179 8 / 0.4); color: rgb(202 138 4); background: rgb(234 179 8 / 0.08);">
                  Hiring in progress
                </span>
              )}
            </div>
          </article>
        );

        return isActive ? (
          <a href={`/agents/${name.toLowerCase()}`} class="block no-underline agent-link">
            {inner}
          </a>
        ) : (
          inner
        );
      })}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Neucha&display=swap');

  .agents-title {
    font-family: 'Neucha', sans-serif;
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.2;
    display: block;
    text-align: right;
  }

  .agent-card {
    display: grid;
    grid-template-columns: 4px 72px 1fr auto;
    align-items: center;
    gap: 1.25rem;
    padding: 1.25rem 1.25rem 1.25rem 0;
    border: 1.5px solid var(--agent-color);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    background: var(--color-background);
    transition: box-shadow 0.2s ease;
  }

  .agent-link:hover .agent-card {
    box-shadow: 3px 3px 0 var(--agent-color);
  }

  .agent-card--dimmed {
    opacity: 0.5;
  }

  .agent-bar {
    align-self: stretch;
    width: 4px;
    border-radius: 4px 0 0 4px;
    min-height: 60px;
  }

  .agent-avatar-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 2px solid;
    flex-shrink: 0;
  }

  .agent-name {
    font-family: 'Neucha', sans-serif;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .agent-badge {
    display: inline-block;
    border: 1.5px solid;
    border-radius: 200px 8px 180px 8px / 8px 180px 8px 200px;
    padding: 0.2rem 0.65rem;
    font-family: 'Neucha', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }
</style>
