---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const allAuthors = await getCollection("authors");

const ORDER = ["TORA", "VERA", "NOVA", "ARIA"];

const agents = allAuthors
  .filter(a => a.data.name !== "JENY")
  .sort((a, b) => {
    return ORDER.indexOf(a.data.name) - ORDER.indexOf(b.data.name);
  });
---

<Layout title="Bots of the SOC">
  <Header />
  <main id="main-content" class="app-layout">

    <div class="py-10 border-b border-border">
      <h1 class="agents-title">Bots of the SOC</h1>
      <p class="text-base mt-4 text-foreground leading-relaxed text-right">
        Autonomous agents on permanent on-call. Each one handles a distinct layer of security operations — triage, investigation, research, and response.
      </p>
    </div>

    <div class="agents-grid py-8 pb-20">
      {agents.map((agent) => {
        const { name, role, tier, color, bio, avatar } = agent.data;
        const isActive     = name === "TORA" || name === "VERA"  || name === "NOVA";
        const isInactive   = name === "ARIA";
        const isDimmed     = isInactive;

        const inner = (
          <article class={`agent-card${isDimmed ? " agent-card--dimmed" : ""}`} style={`--agent-color: ${color};`}>
            <div class="agent-creature-wrap" aria-hidden="true">
              <div class="agent-creature-glow" style={`background: ${color};`} />
              <img src={avatar} alt="" class="agent-creature-img" />
            </div>

            <h2 class="agent-name" style={`color: ${color};`}>{name}</h2>
            <p class="agent-role">{role}</p>

            <div class="agent-badges">
              <span class="agent-badge" style={`border-color: ${color}; color: ${color}; background: ${color}12;`}>
                {tier}
              </span>
              {isActive && (
                <span class="agent-badge" style="border-color: rgb(34 197 94 / 0.4); color: rgb(22 163 74); background: rgb(34 197 94 / 0.08);">
                  Active
                </span>
              )}
              {isInactive && (
                <span class="agent-badge" style="border-color: rgb(234 179 8 / 0.4); color: rgb(202 138 4); background: rgb(234 179 8 / 0.08);">
                  Hiring in progress
                </span>
              )}
            </div>

            <p class="agent-bio">{bio}</p>
          </article>
        );

        return isActive ? (
          <a href={`/agents/${name.toLowerCase()}`} class="block no-underline agent-link">
            {inner}
          </a>
        ) : (
          inner
        );
      })}
    </div>
  </main>
  <Footer />
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Neucha&display=swap');

  .agents-title {
    font-family: 'Neucha', sans-serif;
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.2;
    display: block;
    text-align: right;
  }

  .agents-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.25rem;
  }

  @media (max-width: 640px) {
    .agents-grid { grid-template-columns: 1fr; }
  }

  .agent-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    overflow: hidden;
    padding: 1.75rem 1.5rem 1.5rem;
    text-align: center;
    border: 1.5px solid var(--agent-color);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    background: color-mix(in srgb, var(--agent-color) 8%, var(--color-background));
    transition: box-shadow 0.2s ease, background 0.2s ease, transform 0.2s ease;
  }

  .agent-link:hover .agent-card {
    box-shadow: 3px 3px 0 var(--agent-color);
    background: color-mix(in srgb, var(--agent-color) 14%, var(--color-background));
    transform: translateY(-2px);
  }

  .agent-card--dimmed {
    opacity: 0.55;
  }

  .agent-creature-wrap {
    position: relative;
    display: flex;
    align-items: flex-end;
    justify-content: center;
    width: 100%;
    height: 150px;
    margin-bottom: 0.5rem;
  }

  .agent-creature-glow {
    position: absolute;
    bottom: 6px;
    width: 70%;
    height: 40%;
    border-radius: 50%;
    filter: blur(18px);
    opacity: 0.35;
  }

  .agent-creature-img {
    position: relative;
    height: 100%;
    width: auto;
    max-width: 100%;
    object-fit: contain;
    object-position: bottom center;
  }

  .agent-card--dimmed .agent-creature-img {
    filter: grayscale(0.5);
  }

  .agent-name {
    font-family: 'Neucha', sans-serif;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .agent-role {
    font-size: 0.75rem;
    color: var(--color-foreground);
    opacity: 0.5;
    margin-top: 0.2rem;
  }

  .agent-badges {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .agent-badge {
    display: inline-block;
    border: 1.5px solid;
    border-radius: 200px 8px 180px 8px / 8px 180px 8px 200px;
    padding: 0.2rem 0.65rem;
    font-family: 'Neucha', sans-serif;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    white-space: nowrap;
  }

  .agent-bio {
    margin-top: 1rem;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-foreground);
    opacity: 0.8;
  }
</style>
