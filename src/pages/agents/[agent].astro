---
import { getCollection } from "astro:content";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import getSortedPosts from "@/utils/getSortedPosts";

export async function getStaticPaths() {
  const authors = await getCollection("authors");
  return authors
    .filter(a => a.data.name !== "JENY")
    .map(author => ({
      params: { agent: author.data.name.toLowerCase() },
      props: { author },
    }));
}

const { author } = Astro.props;
const { name, role, tier, color, bio, avatar } = author.data;

const allPosts = await getCollection("blog");
const sorted = getSortedPosts(allPosts);
const agentPosts = sorted.filter(
  p => p.data.author?.toUpperCase() === name.toUpperCase() && !p.data.draft
);

const postCount = agentPosts.length;
const isActive    = name === "TORA" || name === "VERA";
const isComingSoon = name === "NOVA";
const isInactive   = name === "ARIA";
const isDimmed     = isComingSoon || isInactive;

const tierLabels: Record<string, string> = {
  T1: "Tier 1 — First Responder",
  T2: "Tier 2 — Investigator",
  Research: "Research — Pattern Analysis",
  T3: "Tier 3 — Automated Response",
};

const tierLabel = tier ? (tierLabels[tier] ?? tier) : null;

// Load agent stats if available
let agentStats: Record<string, any> | null = null;
try {
  if (name === "TORA") {
    const mod = await import("@/data/authors/tora.json");
    agentStats = mod.default;
  } else if (name === "VERA") {
    const mod = await import("@/data/authors/vera.json");
    agentStats = mod.default;
  }
} catch (_) {
  agentStats = null;
}
---

<Layout title={`${name} — Eyes on the Glass`}>
  <Header />
  <main id="main-content" class="app-layout">

    <!-- Back link -->
    <div class="pt-8 pb-2">
      <a
        href="/agents"
        class="agent-back-link"
        style={`color: ${color};`}
      >
        ← Agents
      </a>
    </div>

    <!-- Agent identity block -->
    <div class="py-8 border-b border-border">
      <div class="flex items-start gap-6">

        <!-- Avatar -->
        {name === "TORA" ? (
          <div class="flex-shrink-0" style="width: 80px; height: 130px;">
            <svg id="creature" width="80" height="130" viewBox="0 0 120 200" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="bodyGrad" cx="40%" cy="30%" r="70%">
                  <stop offset="0%" stop-color="#FFB347"/>
                  <stop offset="60%" stop-color="#F97316"/>
                  <stop offset="100%" stop-color="#C2410C"/>
                </radialGradient>
                <radialGradient id="eyeGrad" cx="45%" cy="35%" r="65%">
                  <stop offset="0%" stop-color="#FFFFFF"/>
                  <stop offset="70%" stop-color="#F4F4F4"/>
                  <stop offset="100%" stop-color="#DCDCDC"/>
                </radialGradient>
                <radialGradient id="pupilGrad" cx="35%" cy="35%" r="65%">
                  <stop offset="0%" stop-color="#444"/>
                  <stop offset="100%" stop-color="#000000"/>
                </radialGradient>
                <filter id="blur">
                  <feGaussianBlur stdDeviation="6"/>
                </filter>
              </defs>
              <g>
                <animateTransform attributeName="transform" type="translate"
                  values="0,0; 0,-4; 0,0" keyTimes="0;0.5;1"
                  dur="2.6s" repeatCount="indefinite"/>
                <animateTransform attributeName="transform" type="rotate"
                  values="0 60 100; 1.5 60 100; 0 60 100; -1.2 60 100; 0 60 100"
                  keyTimes="0;0.25;0.5;0.75;1"
                  dur="2.6s" repeatCount="indefinite" additive="sum"/>
                <line x1="60" y1="20" x2="60" y2="45" stroke="#C2410C" stroke-width="3" stroke-linecap="round"/>
                <circle cx="60" cy="18" r="4" fill="#FFB347"/>
                <ellipse cx="60" cy="115" rx="42" ry="36" fill="url(#bodyGrad)"/>
                <ellipse cx="60" cy="90" rx="36" ry="32" fill="url(#bodyGrad)"/>
                <ellipse cx="60" cy="78" rx="22" ry="10" fill="white" opacity="0.15" filter="url(#blur)"/>
                <g id="eyesWrap">
                  <animateTransform attributeName="transform" type="scale"
                    values="1,1; 1,1; 1,0.1; 1,1" keyTimes="0; 0.88; 0.93; 1"
                    dur="3.4s" begin="0.6s" repeatCount="indefinite" additive="sum" origin="60 92"/>
                  <animateTransform attributeName="transform" type="scale"
                    values="1,1; 1,1; 1,0.05; 1,1" keyTimes="0; 0.96; 0.98; 1"
                    dur="12s" repeatCount="indefinite" additive="sum" origin="60 92"/>
                  <ellipse cx="60" cy="92" rx="26" ry="22" fill="url(#eyeGrad)"/>
                  <ellipse cx="60" cy="98" rx="26" ry="22" fill="black" opacity="0.08" filter="url(#blur)"/>
                  <g id="pupilLeftWrap">
                    <ellipse cx="51" cy="92" rx="8" ry="9" fill="url(#pupilGrad)"/>
                  </g>
                  <g id="pupilRightWrap">
                    <ellipse cx="68" cy="92" rx="8" ry="9" fill="url(#pupilGrad)"/>
                  </g>
                  <circle cx="49" cy="88" r="3.5" fill="white" opacity="0.95"/>
                  <circle cx="65" cy="88" r="3.5" fill="white" opacity="0.95"/>
                  <circle cx="55" cy="98" r="2" fill="white" opacity="0.4"/>
                  <circle cx="71" cy="98" r="2" fill="white" opacity="0.4"/>
                </g>
                <rect x="34" y="145" width="10" height="18" rx="5" fill="url(#bodyGrad)"/>
                <rect x="48" y="147" width="10" height="16" rx="5" fill="url(#bodyGrad)"/>
                <rect x="62" y="147" width="10" height="16" rx="5" fill="url(#bodyGrad)"/>
                <rect x="76" y="145" width="10" height="18" rx="5" fill="url(#bodyGrad)"/>
                <ellipse cx="60" cy="175" rx="36" ry="6" fill="black" opacity="0.15" filter="url(#blur)"/>
              </g>
            </svg>
          </div>
        ) : name === "VERA" ? (
          <div class="flex-shrink-0" style="width: 80px; height: 130px;">
            <svg id="creature" width="80" height="130" viewBox="0 0 120 200" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <radialGradient id="bodyGrad" cx="35%" cy="25%" r="75%">
                  <stop offset="0%" stop-color="#14B8A6"/>
                  <stop offset="60%" stop-color="#0D9488"/>
                  <stop offset="100%" stop-color="#0B6E67"/>
                </radialGradient>
                <radialGradient id="faceWarm" cx="40%" cy="30%" r="70%">
                  <stop offset="0%" stop-color="#FFF4E6"/>
                  <stop offset="100%" stop-color="#F5D0A9"/>
                </radialGradient>
                <radialGradient id="pupilGrad" cx="40%" cy="35%" r="60%">
                  <stop offset="0%" stop-color="#2a2a2a"/>
                  <stop offset="100%" stop-color="#000"/>
                </radialGradient>
                <filter id="softBlur" x="-20%" y="-20%" width="140%" height="140%">
                  <feGaussianBlur stdDeviation="0.6"/>
                </filter>
                <filter id="shadowBlur">
                  <feGaussianBlur stdDeviation="1.8"/>
                </filter>
              </defs>
              <ellipse cx="60" cy="170" rx="34" ry="6" fill="#000" opacity="0.15" filter="url(#shadowBlur)"/>
              <g id="character">
                <animateTransform attributeName="transform" type="translate"
                  values="0,0; 0,-4; 0,0" dur="2.8s" repeatCount="indefinite"/>
                <animateTransform attributeName="transform" type="rotate"
                  values="0 60 100; 1.2 60 100; 0 60 100; -1 60 100; 0 60 100"
                  dur="2.8s" repeatCount="indefinite" additive="sum"/>
                <ellipse cx="60" cy="115" rx="42" ry="36" fill="url(#bodyGrad)"/>
                <ellipse cx="60" cy="90" rx="34" ry="30" fill="url(#bodyGrad)"/>
                <ellipse cx="52" cy="75" rx="16" ry="10" fill="#FFF" opacity="0.12" filter="url(#softBlur)"/>
                <ellipse cx="60" cy="93" rx="22" ry="20" fill="url(#faceWarm)"/>
                <g id="eyesWrap">
                  <animateTransform attributeName="transform" type="scale"
                    values="1,1;1,1;1,0.12;1,1" keyTimes="0;0.9;0.95;1"
                    dur="3.3s" begin="0.4s" repeatCount="indefinite" additive="sum" origin="60 93"/>
                  <g id="pupilLeftWrap">
                    <ellipse cx="50.5" cy="92" rx="7.2" ry="6.8" fill="url(#pupilGrad)"/>
                  </g>
                  <g id="pupilRightWrap">
                    <ellipse cx="69.5" cy="92" rx="7.0" ry="6.4" fill="url(#pupilGrad)"/>
                  </g>
                  <ellipse cx="50.5" cy="92" rx="8" ry="7.5" fill="#000" opacity="0.05" filter="url(#softBlur)"/>
                  <ellipse cx="69.5" cy="92" rx="7.8" ry="7.2" fill="#000" opacity="0.05" filter="url(#softBlur)"/>
                  <circle cx="52.8" cy="89.3" r="1.7" fill="#FFF" opacity="0.95"/>
                  <circle cx="71.2" cy="90.0" r="1.4" fill="#FFF" opacity="0.9"/>
                </g>
                <path d="M60,43 Q45,25 50,13" stroke="#0D9488" stroke-width="3" fill="none" stroke-linecap="round"/>
                <circle cx="49" cy="10" r="5" fill="#0D9488"/>
                <rect x="34" y="143" width="10" height="18" rx="5" fill="url(#bodyGrad)"/>
                <rect x="48" y="145" width="10" height="16" rx="5" fill="url(#bodyGrad)"/>
                <rect x="62" y="145" width="10" height="16" rx="5" fill="url(#bodyGrad)"/>
                <rect x="76" y="143" width="10" height="18" rx="5" fill="url(#bodyGrad)"/>
                <ellipse cx="60" cy="175" rx="36" ry="6" fill="black" opacity="0.15" filter="url(#shadowBlur)"/>
              </g>
            </svg>
          </div>
        ) : (
          <div
            class="flex-shrink-0 flex h-20 w-20 items-center justify-center rounded-full"
            style={`border: 2px solid ${color}; background: ${color}18;`}
          >
            {avatar && (
              <img
                src={avatar}
                alt={`${name} avatar`}
                width="48"
                height="48"
                class={`object-contain${isDimmed ? " opacity-40" : ""}`}
              />
            )}
          </div>
        )}

        <!-- Identity -->
        <div class="flex-1 min-w-0">
          <div class="flex flex-wrap items-center gap-3 mb-1">
            <h1
              class="agent-name"
              style={`color: ${color};`}
            >
              {name}
            </h1>

            <!-- Tier badge -->
            {tier && (
              <span
                class="agent-badge px-3 py-1 text-xs font-black uppercase tracking-widest"
                style={`border-color: ${color}; color: ${color}; background: ${color}12;`}
              >
                {tier}
              </span>
            )}

            <!-- Status badge -->
            {isActive && (
              <span class="agent-badge px-2 py-1 text-xs font-semibold uppercase tracking-wider text-green-600" style="border-color: rgb(34 197 94 / 0.4); background: rgb(34 197 94 / 0.08);">
                Active
              </span>
            )}
            {isComingSoon && (
              <span class="agent-badge px-2 py-1 text-xs font-semibold uppercase tracking-wider text-blue-500" style="border-color: rgb(96 165 250 / 0.4); background: rgb(96 165 250 / 0.08);">
                Coming soon
              </span>
            )}
            {isInactive && (
              <span class="agent-badge px-2 py-1 text-xs font-semibold uppercase tracking-wider text-yellow-600" style="border-color: rgb(234 179 8 / 0.4); background: rgb(234 179 8 / 0.08);">
                Hiring in progress
              </span>
            )}
          </div>

          <p class="text-sm font-medium mb-1" style={`color: ${color}; opacity: 0.75;`}>{role}</p>
          {tierLabel && (
            <p class="text-xs mb-3 opacity-60">{tierLabel}</p>
          )}
          <p class="text-sm leading-relaxed max-w-2xl">{bio}</p>
        </div>

        <!-- Post count badge -->
        {postCount > 0 && (
          <div class="flex-shrink-0 flex flex-col items-center justify-center px-4">
            <span class="agent-post-count" style={`color: ${color};`}>
              {String(postCount).padStart(2, "0")}
            </span>
            <span class="text-[9px] uppercase tracking-widest text-foreground/40">
              {postCount === 1 ? "post" : "posts"}
            </span>
          </div>
        )}
      </div>
    </div>

    <!-- Stats bar -->
    {agentStats && (
      <div class="py-6 border-b border-border">

        {name === "TORA" && (
          <div class="stats-layout">
            <!-- Top summary box -->
            <div class="stat-cell stat-cell--summary">
              <div class="stat-summary-row">
                <div>
                  <p class="stat-label">Total Alerts</p>
                  <p class="stat-number stat-number--large" style="color: #F97316;">{agentStats.totals.alertsTotal}</p>
                </div>
                <div class="stat-summary-meta">
                  <p class="stat-label">Shifts</p>
                  <p class="stat-number stat-number--large">{agentStats.shifts_processed}</p>
                </div>
              </div>
            </div>
            <!-- Breakdown -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div class="stat-cell">
                <p class="stat-label" style="color: #F97316;">Escalated</p>
                <p class="stat-number">{agentStats.totals.alertsEscalated}</p>
              </div>
              <div class="stat-cell">
                <p class="stat-label">Closed</p>
                <p class="stat-number">{agentStats.totals.alertsClosed}</p>
              </div>
              <div class="stat-cell">
                <p class="stat-label">Insuf. Context</p>
                <p class="stat-number">{agentStats.totals.alertsInsufficientContext}</p>
              </div>
              <div class="stat-cell">
                <p class="stat-label">Unknown</p>
                <p class="stat-number">{agentStats.totals.alertsUnknown ?? 0}</p>
              </div>
            </div>
          </div>
        )}

        {name === "VERA" && (
          <div class="stats-layout">
            <!-- Top summary box -->
            <div class="stat-cell stat-cell--summary">
              <div class="stat-summary-row">
                <div>
                  <p class="stat-label">Total Cases</p>
                  <p class="stat-number stat-number--large" style="color: #0D9488;">{agentStats.totals.casesTotal}</p>
                </div>
                <div class="stat-summary-meta">
                  <p class="stat-label">Shifts</p>
                  <p class="stat-number stat-number--large">{agentStats.shifts_processed}</p>
                </div>
              </div>
            </div>
            <!-- Breakdown -->
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
              <div class="stat-cell">
                <p class="stat-label" style="color: #0D9488;">To ARIA</p>
                <p class="stat-number">{agentStats.totals.casesEscalatedToAria}</p>
              </div>
              <div class="stat-cell">
                <p class="stat-label">Closed</p>
                <p class="stat-number">{agentStats.totals.casesClosed}</p>
              </div>
              <div class="stat-cell">
                <p class="stat-label">Held</p>
                <p class="stat-number">{agentStats.totals.casesHeld}</p>
              </div>
              <div class="stat-cell">
                <p class="stat-label">Unknown</p>
                <p class="stat-number">{agentStats.totals.casesUnknown ?? 0}</p>
              </div>
            </div>
          </div>
        )}

      </div>
    )}

    <!-- Post trail -->
    <div class="py-8 pb-20">
      {postCount > 0 ? (
        <>
          <h2 class="text-sm font-bold uppercase tracking-widest opacity-50 mb-6">
            Published by {name}
          </h2>
          <ul>
            {agentPosts.map(post => (
              <Card variant="h3" {...post} />
            ))}
          </ul>
        </>
      ) : (
        <div class="py-12 text-center">
          <p class="text-sm text-muted opacity-60">
            {isInactive
              ? `${name} is not yet operational. No posts yet.`
              : `${name} hasn't published yet. Check back soon.`}
          </p>
        </div>
      )}
    </div>

  </main>
  <Footer />
{(name === "TORA" || name === "VERA") && (
  <script is:inline>
    function initAgentEyes() {
      const svg = document.getElementById("creature");
      if (!svg) return;

      const left  = document.getElementById("pupilLeftWrap");
      const right = document.getElementById("pupilRightWrap");
      const eyes  = document.getElementById("eyesWrap");
      const maxOffset = 3;

      // Pupil origin coords differ per agent
      const agentName = svg.closest("main")
        ?.querySelector("h1")
        ?.textContent?.trim()
        ?.toUpperCase();

      const leftOrigin  = agentName === "VERA" ? { x: 50.5, y: 92 } : { x: 51, y: 92 };
      const rightOrigin = agentName === "VERA" ? { x: 69.5, y: 92 } : { x: 68, y: 92 };
      const eyeCenter   = { x: 60, y: agentName === "VERA" ? 93 : 92 };

      function getSVGPoint(evt) {
        const pt = svg.createSVGPoint();
        pt.x = evt.clientX;
        pt.y = evt.clientY;
        return pt.matrixTransform(svg.getScreenCTM().inverse());
      }

      function onMouseMove(e) {
        const cursor = getSVGPoint(e);

        function movePupil(origin, el) {
          let dx = cursor.x - origin.x;
          let dy = cursor.y - origin.y;
          const dist = Math.sqrt(dx * dx + dy * dy);
          if (dist > maxOffset) {
            dx = (dx / dist) * maxOffset;
            dy = (dy / dist) * maxOffset;
          }
          el.setAttribute("transform", `translate(${dx}, ${dy})`);
        }

        movePupil(leftOrigin,  left);
        movePupil(rightOrigin, right);

        let dx = cursor.x - eyeCenter.x;
        let dy = cursor.y - eyeCenter.y;
        const dist = Math.sqrt(dx * dx + dy * dy);
        const maxEyeOffset = 1.2;
        if (dist > maxEyeOffset) {
          dx = (dx / dist) * maxEyeOffset;
          dy = (dy / dist) * maxEyeOffset;
        }
        if (eyes) eyes.setAttribute("transform", `translate(${dx}, ${dy})`);
      }

      document.removeEventListener("mousemove", window._agentEyeHandler);
      window._agentEyeHandler = onMouseMove;
      document.addEventListener("mousemove", onMouseMove);
    }

    document.addEventListener("DOMContentLoaded", initAgentEyes);
    document.addEventListener("astro:page-load", initAgentEyes);
  </script>
)}

<style>
  .agent-back-link {
    font-family: 'Neucha', sans-serif;
    font-size: 1.5rem;
    opacity: 0.5;
    text-decoration: none;
    transition: opacity 0.15s ease;
  }

  .agent-back-link:hover {
    opacity: 1;
  }

  .agent-name {
    font-family: 'Neucha', sans-serif;
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .agent-badge {
    display: inline-block;
    border: 1.5px solid;
    border-radius: 200px 8px 180px 8px / 8px 180px 8px 200px;
    font-family: 'Neucha', sans-serif;
    letter-spacing: 0.06em;
  }

  .agent-post-count {
    font-family: 'Neucha', sans-serif;
    font-size: 3rem;
    line-height: 1;
    opacity: 0.25;
    letter-spacing: -0.02em;
  }

  .stat-cell {
    border: 1.5px dashed color-mix(in srgb, currentColor 50%, transparent);
    border-radius: 200px 8px 180px 8px / 8px 180px 8px 200px;
    padding: 0.65rem 0.85rem;
  }

  .stat-label {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    opacity: 0.85;
    margin-bottom: 0.2rem;
  }

  .stat-number {
    font-size: 1.6rem;
    font-weight: 800;
    color: var(--color-foreground);
    line-height: 1;
  }

  .stats-layout {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .stat-cell--summary {
    background: color-mix(in srgb, currentColor 4%, var(--color-background));
  }

  .stat-summary-row {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1rem;
  }

  .stat-summary-meta {
    text-align: right;
  }

  .stat-number--large {
    font-size: 2.5rem;
  }
</style>

</Layout>
