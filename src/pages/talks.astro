---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";

const talks = [
  {
    title: "Building an Autonomous SOC as a Knowledge System",
    event: "AI Cyber Alliance",
    date: "June 16, 2026",
    format: "Remote",
    description:
      "A live walkthrough of Eyes on the Glass — ten shifts of real operational data, two findings that reshaped the architecture, and where the system is going next.",
    pdf: "/talks/eotg-aicyberalliance-talk.pdf",
    recording: null,
    eventUrl: "https://www.linkedin.com/feed/update/urn:li:activity:7470493061886722048/",
    agents: ["TORA", "VERA"],
    colors: ["#D9762B", "#2F8577"],
  },
];
---

<Layout title="Talks — Eyes on the Glass">
  <Header />
  <main id="main-content" class="app-layout">

    <div class="py-10 border-b border-border">
      <h1 class="talks-title">Talks</h1>
      <p class="text-sm mt-3 text-foreground/60 max-w-xl">
        Public talks about Eyes on the Glass — the system, the findings, and what gets learned when you build in the open.
      </p>
    </div>

    <div class="talks-list py-10">
      {talks.map(talk => (
        <div class="talk-card">
          <div class="talk-meta">
            <span class="talk-event">{talk.event} · {talk.date}</span>
            <div class="talk-agents">
              {talk.agents.map((a, i) => (
                <span class="talk-agent-dot" style={`background: ${talk.colors[i]};`} title={a} />
              ))}
            </div>
          </div>

          <h2 class="talk-card-title">{talk.title}</h2>

          <p class="talk-description">{talk.description}</p>

          <div class="talk-links">
            <a href={talk.pdf} class="talk-link" target="_blank" rel="noopener noreferrer">
              Slides (PDF)
            </a>
            {talk.recording ? (
              <a href={talk.recording} class="talk-link" target="_blank" rel="noopener noreferrer">
                Recording
              </a>
            ) : (
              <span class="talk-link-soon">Recording — pending release</span>
            )}
            {talk.eventUrl && (
              <a href={talk.eventUrl} class="talk-link" target="_blank" rel="noopener noreferrer">
                Event
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

  </main>
  <Footer />
</Layout>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Neucha&display=swap');

  .talks-title {
    font-family: 'Neucha', sans-serif;
    font-size: clamp(24px, 4vw, 34px);
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.2;
  }

  .talks-list {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .talk-card {
    border: 1.5px solid var(--color-foreground);
    border-radius: 255px 15px 225px 15px / 15px 225px 15px 255px;
    padding: 1.4rem 1.6rem 1.5rem;
    transition: box-shadow 0.2s ease;
  }

  .talk-card:hover {
    box-shadow: 4px 4px 0 var(--color-foreground);
  }

  .talk-meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.5rem;
  }

  .talk-event {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    opacity: 0.4;
  }

  .talk-agents {
    display: flex;
    gap: 0.25rem;
  }

  .talk-agent-dot {
    width: 8px;
    height: 8px;
    border-radius: 2px;
    display: inline-block;
  }

  .talk-card-title {
    font-family: 'Neucha', sans-serif;
    font-size: clamp(1rem, 2vw, 1.25rem);
    font-weight: 700;
    color: var(--color-foreground);
    line-height: 1.3;
    margin-bottom: 0.6rem;
  }

  .talk-description {
    font-size: 0.875rem;
    color: var(--color-foreground);
    opacity: 0.7;
    line-height: 1.6;
    margin-bottom: 1rem;
  }

  .talk-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
  }

  .talk-link {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    text-decoration: underline;
    text-underline-offset: 3px;
    opacity: 0.6;
    transition: opacity 0.15s;
  }

  .talk-link:hover {
    opacity: 1;
  }

  .talk-link-soon {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-foreground);
    opacity: 0.3;
    font-style: italic;
  }
</style>
